#!/bin/sh
# Conventional commits: type(scope)!: subject

msg=$(head -n1 "$1")

case "$msg" in
    Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;;
esac

if ! printf '%s' "$msg" | grep -qE '^(feat|fix|refactor|perf|style|docs|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
    echo "commit-msg: not a conventional commit:" >&2
    echo "  $msg" >&2
    echo "expected: type(scope): subject   (feat|fix|refactor|perf|style|docs|test|build|ci|chore|revert)" >&2
    exit 1
fi
